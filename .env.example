# Copy this file to .env and fill your keys
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional: override the default model (gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Kimi (platform.kimi.ai). Create a key under API Keys, then run with --provider kimi.
# MOONSHOT_API_KEY=YOUR_KIMI_API_KEY_HERE
# KIMI_MODEL=kimi-k3.1-pro
# KIMI_REASONING_EFFORT=low

# Optional: yt-dlp / MCP transcript fallback
# YT_COOKIES=cookies.txt
# YT_COOKIES_FROM_BROWSER=firefox
# YT_COOKIES_PROFILE=Default
# RUSTYPIPE_BG_BIN=
# YT_PO_TOKEN=
